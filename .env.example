# Lounge — Supabase Environment Variables
# Copy this file to .env and fill in your Supabase project values.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# LiveKit (Airwaves › Drop-in Rooms). Server URL is safe in the browser;
# the API key/secret are set as Supabase function secrets, not here.
VITE_LIVEKIT_URL=wss://your-project.livekit.cloud
